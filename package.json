{
  "name": "fgsnotes",
  "version": "2.5.5",
  "description": "FgSNotes — Markdown editor",
  "main": "main.js",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "start": "electron .",
    "dist": "electron-builder --dir",
    "build:mac-arm64": "electron-builder --mac --arm64",
    "build:win32": "electron-builder --win --ia32",
    "build:all": "electron-builder --mac --win --linux",
    "build:mac": "electron-builder --mac --arm64 --x64",
    "build:win": "electron-builder --win --x64 --ia32",
    "build:linux": "electron-builder --linux --x64",
    "web:build": "node scripts/build-device.js && node scripts/build-web.js",
    "cap:sync": "npm run web:build && cap sync",
    "ios": "npm run cap:sync && cap open ios",
    "android": "npm run cap:sync && cap open android",
    "editor:build": "node scripts/build-editor.js",
    "icons": "scripts/build-icons.sh",
    "device:build": "node scripts/build-device.js"
  },
  "keywords": [],
  "author": {
    "name": "FrogeeSoft",
    "email": "frogeesoft.team@gmail.com"
  },
  "license": "ISC",
  "build": {
    "appId": "FrogeeSoft",
    "productName": "FgSNotes",
    "mac": {
      "icon": "src/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "identity": null,
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "win": {
      "icon": "src/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64",
            "ia32"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    },
    "linux": {
      "icon": "src/icon.png",
      "category": "Office",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "files": [
      "main.js",
      "preload.js",
      "ollama.js",
      "providers.js",
      "keystore.js",
      "src/**/*",
      "package.json",
      "!src/vendor/ort/**",
      "!src/ai/device-engine.js"
    ]
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@huggingface/transformers": "^4.3.1",
    "@lezer/common": "^1.5.3",
    "@lezer/markdown": "^1.8.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "esbuild": "^0.28.2",
    "fgs-llama": "file:plugins/fgs-llama",
    "katex": "^0.19.0"
  }
}